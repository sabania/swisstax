     1.\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      dem Departement f\u0026uuml;r Finanzen und Soziales;\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--t-1‐--a-1--p-1--l-2‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      2.\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      der Steuerverwaltung;\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--t-1‐--a-1--p-1--l-3‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      3.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      den Veranlagungsexperten und Veranlagungsexpertinnen der Steuerverwaltung;\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--t-1‐--a-1--p-1--l-4‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      4.\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      der Steuerrekurskommission;\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--t-1‐--a-1--p-1--l-5‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      5.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      dem Verwaltungsgericht;\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--t-1‐--a-1--p-1--l-6‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      6.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      den Notariaten.\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]}],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-1‐--a-2","type":"article","number":{"de":"§\u0026nbsp;2"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003e\u0026sect;\u003c/span\u003e \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eDepartement\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Departement"},"children":[{"uid":"t-0--t-1‐--a-2--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie kantonale Aufsicht obliegt dem Departement.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-1‐--a-2--p-2","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eEs entscheidet \u0026uuml;ber strittige Ausstandsbegehren gem\u0026auml;ss Art.\u0026nbsp;109 Abs.\u0026nbsp;3 des Gesetzes.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-1‐--a-3","type":"article","number":{"de":"§\u0026nbsp;3"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003e\u0026sect;\u003c/span\u003e \u003cspan class='number'\u003e3\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eSteuerverwaltung\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Steuerverwaltung"},"children":[{"uid":"t-0--t-1‐--a-3--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eKantonale Verwaltung f\u0026uuml;r die direkte Bundessteuer ist die Steuerverwaltung.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-1‐--a-3--p-2","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eSie leitet und \u0026uuml;berwacht den Vollzug und die einheitliche Anwendung des Gesetzes. Sie kann die notwendigen Weisungen erlassen.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-1‐--a-3--p-3","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e3\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eSie ist insbesondere zust\u0026auml;ndig f\u0026uuml;r:\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[{"uid":"t-0--t-1‐--a-3--p-3--l-1‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      1.\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      die Abrechnung mit dem Bund (Art.\u0026nbsp;89, Art.\u0026nbsp;101 und Art.\u0026nbsp;196);\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--t-1‐--a-3--p-3--l-2‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      2.\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      Bezug und Sicherung der Steuer;\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--t-1‐--a-3--p-3--l-3‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      3.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      die Behandlung von Erlassgesuchen;\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--t-1‐--a-3--p-3--l-4‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      4.\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      die Verfolgung der Steuerhinterziehungen und der Verletzungen von Verfahrenspflichten (Art.\u0026nbsp;182 Abs.\u0026nbsp;4);\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--t-1‐--a-3--p-3--l-5‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      5.\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      die Strafanzeige wegen Steuerbetrugs und Veruntreuung von Quellensteuern (Art.\u0026nbsp;188 Abs.\u0026nbsp;1).\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]}],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-1‐--a-4","type":"article","number":{"de":"§\u0026nbsp;4\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003e\u0026sect;\u003c/span\u003e \u003cspan class='number'\u003e4\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eVeranlagungsbeh\u0026ouml;rde\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Veranlagungsbehörde"},"children":[{"uid":"t-0--t-1‐--a-4--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDer Veranlagungsexperte oder die Veranlagungsexpertin veranlagt die direkte Bundessteuer und entscheidet \u0026uuml;ber Einsprachen.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-1‐--a-5","type":"article","number":{"de":"§\u0026nbsp;5"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003e\u0026sect;\u003c/span\u003e \u003cspan class='number'\u003e5\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eSteuerrekurskommission\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Steuerrekurskommission"},"children":[{"uid":"t-0--t-1‐--a-5--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eKantonale Rekurskommission ist die Steuerrekurskommission.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-1‐--a-5a","type":"article","number":{"de":"§\u0026nbsp;5a\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003e\u0026sect;\u003c/span\u003e \u003cspan class='number'\u003e5a\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eBeschwerdeberechtigung\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Beschwerdeberechtigung"},"children":[{"uid":"t-0--t-1‐--a-5a--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eGegen Entscheide der Steuerrekurskommission kann neben dem Steuerpflichtigen und der Eidgen\u0026ouml;ssischen Steuerverwaltung auch die Steuerverwaltung Beschwerde beim kantonalen Verwaltungsgericht f\u0026uuml;hren.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-1‐--a-6","type":"article","number":{"de":"§\u0026nbsp;6"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003e\u0026sect;\u003c/span\u003e \u003cspan class='number'\u003e6\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eNotariat\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Notariat"},"children":[{"uid":"t-0--t-1‐--a-6--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eInventaraufnahme und Siegelung erfolgen durch das Notariat (Art.\u0026nbsp;159 Abs.\u0026nbsp;1).\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-1‐--a-7","type":"article","number":{"de":"§\u0026nbsp;7"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003e\u0026sect;\u003c/span\u003e \u003cspan class='number'\u003e7\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eMitwirkung der Gemeinden\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Mitwirkung der Gemeinden"},"children":[{"uid":"t-0--t-1‐--a-7--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie Politischen Gemeinden haben bei den Vorbereitungsarbeiten, bei der Veranlagung und beim Bezug nach den Weisungen der Steuerverwaltung mitzuwirken. Sie haben die notwendigen Ausk\u0026uuml;nfte zu erteilen.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-1‐--a-7--p-2","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eIn der allgemeinen Mitwirkungsentsch\u0026auml;digung nach \u0026sect; 201 Abs.\u0026nbsp;1 des Gesetzes \u0026uuml;ber die Staats- und Gemeindesteuern (Steuergesetz, StG)\u003ca class=\"footnote\" name=\"paragraphtext_content_fn_1065105_2_2\" href=\"#paragraphtext_content_fn_1065105_2_2_c\" id=\"paragraphtext_content_fn_1065105_2_2\"\u003e[2]\u003c/a\u003e ist die Entsch\u0026auml;digung f\u0026uuml;r die Mitarbeit der Gemeinden bei der direkten Bundessteuer enthalten. Gleiches gilt mit Bezug auf \u0026sect; 52 Abs.\u0026nbsp;1 der Verordnung des Regierungsrates zum Gesetz \u0026uuml;ber die Staats- und Gemeindesteuern (Steuerverordnung, StV)\u003ca class=\"footnote\" name=\"paragraphtext_content_fn_1065105_2_3\" href=\"#paragraphtext_content_fn_1065105_2_3_c\" id=\"paragraphtext_content_fn_1065105_2_3\"\u003e[3]\u003c/a\u003e, wenn eine Gemeinde bei der Veranlagung nat\u0026uuml;rlicher Personen mitwirkt.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]}]},{"uid":"t-0--t-2‐","type":"title","number":{"de":"2."},"html_content":{"de":"\u003cdiv class='level_1 title'\u003e\n  \u003cspan class='number'\u003e2.\u003c/span\u003e \u003cspan class='title_text'\u003eVerfahren\u003c/span\u003e\n\u003c/div\u003e"},"text":{"de":"Verfahren"},"children":[{"uid":"t-0--t-2‐--a-8","type":"article","number":{"de":"§\u0026nbsp;8\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003e\u0026sect;\u003c/span\u003e \u003cspan class='number'\u003e8\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eRechtsmittelverfahren bei der Quellensteuer\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Rechtsmittelverfahren bei der Quellensteuer"},"children":[{"uid":"t-0--t-2‐--a-8--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eEinsprache-, Rekurs- und Beschwerdeverfahren gegen Entscheide \u0026uuml;ber Bestand und Umfang der Quellensteuer richten sich nach den entsprechenden kantonalen Verfahrensvorschriften.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-2‐--a-9","type":"article","number":{"de":"§\u0026nbsp;9\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003e\u0026sect;\u003c/span\u003e \u003cspan class='number'\u003e9\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eKosten des Rechtsmittelverfahrens\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Kosten des Rechtsmittelverfahrens"},"children":[{"uid":"t-0--t-2‐--a-9--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie Verfahrenskosten vor Steuerrekurskommission und vor Verwaltungsgericht richten sich nach den entsprechenden kantonalen Vorschriften.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-2‐--a-9a","type":"article","number":{"de":"§\u0026nbsp;9a\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003e\u0026sect;\u003c/span\u003e \u003cspan class='number'\u003e9a\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eMahn- und Inkassogeb\u0026uuml;hren\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Mahn- und Inkassogebühren"},"children":[{"uid":"t-0--t-2‐--a-9a--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie Steuerverwaltung erhebt f\u0026uuml;r die von ihr bezogenen Bundessteuerbetreffnisse und Bussen Mahn- und Inkassogeb\u0026uuml;hren. Geht nach Ablauf der Zahlungsfrist keine Zahlung ein, so wird der steuerpflichtigen Person eine geb\u0026uuml;hrenfreie Zahlungserinnerung zugestellt.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-2‐--a-9a--p-2","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eBleibt die Zahlungserinnerung ohne Wirkung, wird die steuerpflichtige Person gemahnt. Jede Mahnung l\u0026ouml;st eine Mahngeb\u0026uuml;hr von Fr.\u0026nbsp;50 aus und wird mit dieser in Rechnung gestellt. Deren Anfechtung richtet sich sinngem\u0026auml;ss nach \u0026sect; 191a StG.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-2‐--a-9a--p-3","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e3\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eBleibt auch die Mahnung ohne Wirkung und muss die offene Forderung auf dem Betreibungsweg eingetrieben werden, ist der steuerpflichtigen Person eine Inkassogeb\u0026uuml;hr von Fr.\u0026nbsp;80 aufzuerlegen.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-2‐--a-9a--p-4","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e4\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eRechtskr\u0026auml;ftige Geb\u0026uuml;hrenrechnungen sind vollstreckbaren gerichtlichen Entscheiden im Sinne von Art.\u0026nbsp;80 Abs.\u0026nbsp;2 SchKG\u003ca class=\"footnote\" name=\"paragraphtext_content_fn_1065111_2_4\" href=\"#paragraphtext_content_fn_1065111_2_4_c\" id=\"paragraphtext_content_fn_1065111_2_4\"\u003e[4]\u003c/a\u003e gleichgestellt.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-2‐--a-10","type":"article","number":{"de":"§\u0026nbsp;10"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003e\u0026sect;\u003c/span\u003e \u003cspan class='number'\u003e10\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eErlass\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Erlass"},"children":[{"uid":"t-0--t-2‐--a-10--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDas Gesuch um Erlass rechtskr\u0026auml;ftig festgesetzter Steuern, Zinsen oder Bussen wegen \u0026Uuml;bertretung ist mit schriftlicher Begr\u0026uuml;ndung und unter Beilage der n\u0026ouml;tigen Beweismittel der Steuerverwaltung einzureichen.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-2‐--a-10--p-2","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie Voraussetzungen f\u0026uuml;r die Gew\u0026auml;hrung eines Erlasses sowie das Verfahren richten sich nach dem Gesetz und der Steuererlassverordnung\u003ca class=\"footnote\" name=\"paragraphtext_content_fn_1065113_2_5\" href=\"#paragraphtext_content_fn_1065113_2_5_c\" id=\"paragraphtext_content_fn_1065113_2_5\"\u003e[5]\u003c/a\u003e.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-2‐--a-10--p-3","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e3\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eGegen den Entscheid der Steuerverwaltung kann innert 30\u0026nbsp;Tagen Beschwerde an die Steuerrekurskommission erhoben werden. Das Verfahren richtet sich nach den Bestimmungen von Art.\u0026nbsp;140 bis Art.\u0026nbsp;144 des Gesetzes.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-2‐--a-10--p-4","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e4\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eGegen Entscheide der Steuerrekurskommission kann neben dem Steuerpflichtigen und der Eidgen\u0026ouml;ssischen Steuerverwaltung auch die Steuerverwaltung nach Massgabe des Bundesgesetzes \u0026uuml;ber das Bundesgericht\u003ca class=\"footnote\" name=\"paragraphtext_content_fn_1065115_2_6\" href=\"#paragraphtext_content_fn_1065115_2_6_c\" id=\"paragraphtext_content_fn_1065115_2_6\"\u003e[6]\u003c/a\u003e Beschwerde in \u0026ouml;ffentlich-rechtlichen Angelegenheiten beim Bundesgericht f\u0026uuml;hren.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]}]},{"uid":"t-0--t-3‐","type":"title","number":{"de":"3."},"html_content":{"de":"\u003cdiv class='level_1 title'\u003e\n  \u003cspan class='number'\u003e3.\u003c/span\u003e \u003cspan class='title_text'\u003eSchlussbestimmungen\u003c/span\u003e\n\u003c/div\u003e"},"text":{"de":"Schlussbestimmungen"},"children":[{"uid":"t-0--t-3‐--a-11","type":"article","number":{"de":"§\u0026nbsp;11\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003e\u0026sect;\u003c/span\u003e \u003cspan class='number'\u003e11\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eWechsel der zeitlichen Bemessung f\u0026uuml;r die nat\u0026uuml;rlichen Personen\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Wechsel der zeitlichen Bemessung für die natürlichen Personen"},"children":[{"uid":"t-0--t-3‐--a-11--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDer Wechsel zur einj\u0026auml;hrigen Gegenwartsbemessung f\u0026uuml;r die nat\u0026uuml;rlichen Personen erfolgt auf den 1.\u0026nbsp;Januar 1999.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-3‐--a-11--p-2","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie im Durchschnitt der Jahre 1997 und 1998 angefallenen ausserordentlichen Aufwendungen sind gem\u0026auml;ss Art.\u0026nbsp;218 Abs.\u0026nbsp;4 lit.\u0026nbsp;b des Gesetzes zus\u0026auml;tzlich von den f\u0026uuml;r die Steuerperiode 1999 und 2000 zugrundegelegten steuerbaren Einkommen abzuziehen, solange die Steuerpflicht im Kanton besteht.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-3‐--a-12","type":"article","number":{"de":"§\u0026nbsp;12"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003e\u0026sect;\u003c/span\u003e \u003cspan class='number'\u003e12\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eInkrafttreten\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Inkrafttreten"},"children":[{"uid":"t-0--t-3‐--a-12--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDiese Verordnung tritt am 1.\u0026nbsp;Januar 1995 in Kraft.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]}]}]},"footer":{"de":"\u003cdiv class='egress_sign_off_date'\u003e\u003c/div\u003e\n\u003cdiv class='egress_sign_off_signature'\u003e\u003c/div\u003e\n\u003cdiv class='egress_sign_off_remarks'\u003e\u003c/div\u003e\n\u003cdiv class='egress_ags_source'\u003e\n  ABl. 42/1994\n\u003c/div\u003e"},"annex_documents":{}},"footnotes":{"de":"\u003cdiv class='footnotes' id=''\u003e\n  \u003cdiv class='footnotes-hr'\u003e\u003c/div\u003e\n  \u003col\u003e\n    \u003cli\u003e\n      \u003ca class='footnote' href='#paragraphtext_content_fn_1065094_2_1' name='paragraphtext_content_fn_1065094_2_1_c' id=\"paragraphtext_content_fn_1065094_2_1_c\"\u003e[1]\u003c/a\u003e \u003cspan class='footnote_text'\u003eSR \u003ca class=\"law_link\" href=\"https://db.clex.ch/link
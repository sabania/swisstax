{"text_of_law":{"systematic_number":"640.13","systematic_number_hl":"640.13","title":"Verordnung über den Ausgleich der kalten Progression","title_hl":"Verordnung über den Ausgleich der kalten Progression","abbreviation":"VAKP","abbreviation_hl":"VAKP","enactment":"2023-01-01","date_of_decision":"2022-11-22","date_of_decision_multiple":false,"publication_enactment":"2025-01-01","text_of_law_type_id":5,"text_of_law_dates_str":"vom 22.11.2022, in Kraft seit: 01.01.2023","pdf_link":"https://www.rechtsbuch.tg.ch/api/de/versions/2842/pdf_file_with_annexes","canonical_link":"https://www.rechtsbuch.tg.ch/app/de/texts_of_law/640.13","abrogated":false,"abrogated_dates_str":null,"abrogated_dates_str_short":null,"abrogated_scheduled":false,"abrogated_scheduled_date_str":null,"abrogated_scheduled_date_str_short":null,"version_uid":"5cf0edc26f86ed2139cb1a1b0a67bb09","snippet_msg":null,"snippet":null,"current_version":{"id":2842,"version_dates_str":"Aktuelle Version in Kraft seit: 01.01.2025 (Beschlussdatum: 05.11.2024)","structured_document_id":14746,"title":"Verordnung über den Ausgleich der kalten Progression","abbreviation":"VAKP"},"selected_version":{"id":2842,"version_dates_str":"Aktuelle Version in Kraft seit: 01.01.2025 (Beschlussdatum: 05.11.2024)","structured_document_id":14746,"title":"Verordnung über den Ausgleich der kalten Progression","abbreviation":"VAKP","original_dates_str":"vom 22.11.2022, in Kraft seit: 01.01.2023","pdf_link_tol":"https://www.rechtsbuch.tg.ch/api/de/versions/2842/pdf_file","pdf_link_tol_size":169458,"json_content":{"document":{"header":{"de":"\u003ch2 class='header_text'\u003e\n  VAKP\n\u003c/h2\u003e\n\u003ch1 class='systematic_number'\u003e\n  640.13\n\u003c/h1\u003e\n\u003ch1 class='title'\u003e\n  Verordnung \u0026uuml;ber den Ausgleich der kalten Progression\n\u003c/h1\u003e\n\u003ch2 class='abbreviation'\u003e\n  (VAKP)\n\u003c/h2\u003e\n\u003cdiv class='enactment'\u003e\n  vom 22.11.2022 (Stand 01.01.2025)\n\u003c/div\u003e\n\u003cdiv class='ingress_author'\u003e\u003c/div\u003e\n\u003cdiv class='ingress_foundation'\u003e\n  \u003cp\u003e\n    \u003cem\u003eAnpassung der Sozialabz\u0026uuml;ge gem\u0026auml;ss \u0026sect;\u0026nbsp;36 und des Einkommenssteuertarifs nach \u0026sect;\u0026nbsp;37 des Steuergesetzes (StG)\u003ca class=\"footnote\" name=\"structured_documentingress_foundation_fn_14746_2_1\" href=\"#structured_documentingress_foundation_fn_14746_2_1_c\" id=\"structured_documentingress_foundation_fn_14746_2_1\"\u003e[1]\u003c/a\u003e an den Landesindex der Konsumentenpreise in Anwendung von \u0026sect;\u0026nbsp;40 Abs.\u0026nbsp;2 StG.\u003c/em\u003e\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\n  \u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class='ingress_action'\u003e\u003c/div\u003e"},"content":{"uid":"t-0","type":"title","number":{},"html_content":{"de":""},"text":{},"children":[{"uid":"t-0--a-1","type":"article","number":{"de":"§\u0026nbsp;1"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003e\u0026sect;\u003c/span\u003e \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eSozialabz\u0026uuml;ge\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Sozialabzüge"},"children":[{"uid":"t-0--a-1--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie Sozialabz\u0026uuml;ge gem\u0026auml;ss \u0026sect;\u0026nbsp;36 Abs.\u0026nbsp;2 Ziff.\u0026nbsp;1 bis Ziff.\u0026nbsp;3 StG betragen:\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[{"uid":"t-0--a-1--p-1--l-1‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      1.\n    \u003c/td\u003e\n    \u003ctd class='left_col' colspan='2'\u003e\n      f\u0026uuml;r nicht selbst\u0026auml;ndig besteuerte, f\u0026uuml;r in Ausbildung stehende oder erwerbsunf\u0026auml;hige Kinder, f\u0026uuml;r deren Unterhalt der Steuerpflichtige aufkommt:\n    \u003c/td\u003e\n    \u003ctd class='right_col last'\u003e\n      \u0026nbsp;\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[{"uid":"t-0--a-1--p-1--l-1‐--sl-1‐1","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      \u0026nbsp;\n    \u003c/td\u003e\n    \u003ctd class='number'\u003e\n      1.1\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\n    \u003c/td\u003e\n    \u003ctd class='left_col' colspan='1'\u003e\n      je Kind\n    \u003c/td\u003e\n    \u003ctd class='right_col last'\u003e\n      Fr.\u0026nbsp;7'400\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--a-1--p-1--l-1‐--sl-1‐2","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      \u0026nbsp;\n    \u003c/td\u003e\n    \u003ctd class='number'\u003e\n      1.2\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\n    \u003c/td\u003e\n    \u003ctd class='left_col' colspan='1'\u003e\n      der Abzug erh\u0026ouml;ht sich f\u0026uuml;r jedes in Ausbildung stehende Kind nach Vollendung des 16.\u0026nbsp;Altersjahres auf\n    \u003c/td\u003e\n    \u003ctd class='right_col last'\u003e\n      Fr.\u0026nbsp;8'500\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--a-1--p-1--l-1‐--sl-1‐3","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      \u0026nbsp;\n    \u003c/td\u003e\n    \u003ctd class='number'\u003e\n      1.3\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\n    \u003c/td\u003e\n    \u003ctd class='left_col' colspan='1'\u003e\n      und nach Vollendung des 20.\u0026nbsp;Altersjahres bis h\u0026ouml;chstens zum vollendeten 26.\u0026nbsp;Altersjahr auf\n    \u003c/td\u003e\n    \u003ctd class='right_col last'\u003e\n      Fr.\u0026nbsp;10'600\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]}]},{"uid":"t-0--a-1--p-1--l-2‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      2.\n    \u003c/td\u003e\n    \u003ctd class='left_col' colspan='2'\u003e\n      f\u0026uuml;r erwerbsunf\u0026auml;hige und unterst\u0026uuml;tzungsbed\u0026uuml;rftige Personen, f\u0026uuml;r deren Unterhalt der Steuerpflichtige zur Hauptsache aufkommt; der Abzug kann nicht beansprucht werden f\u0026uuml;r den Ehegatten und f\u0026uuml;r Kinder, f\u0026uuml;r die ein Abzug nach Abs.\u0026nbsp;2 Ziff.\u0026nbsp;1 gew\u0026auml;hrt wird\n    \u003c/td\u003e\n    \u003ctd class='right_col last'\u003e\n      Fr.\u0026nbsp;2'700\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--a-1--p-1--l-3‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      3.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\n    \u003c/td\u003e\n    \u003ctd class='left_col' colspan='2'\u003e\n      von im AHV-Alter stehenden, erwerbsunf\u0026auml;higen oder verwitweten Steuerpflichtigen Fr.\u0026nbsp;4'200; betr\u0026auml;gt das Reineinkommen mehr als Fr.\u0026nbsp;16'900, bei Steuerpflichtigen in ungetrennter Ehe mehr als Fr.\u0026nbsp;24'300, erm\u0026auml;ssigt sich der Abzug je Fr.\u0026nbsp;1'000 Mehreinkommen um Fr.\u0026nbsp;200\n    \u003c/td\u003e\n    \u003ctd class='right_col last'\u003e\n      \u0026nbsp;\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]}],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--a-2","type":"article","number":{"de":"§\u0026nbsp;2"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003e\u0026sect;\u003c/span\u003e \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eTarifstufen des Einkommenssteuertarifs\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Tarifstufen des Einkommenssteuertarifs"},"children":[{"uid":"t-0--a-2--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie einfache Steuer vom Einkommen gem\u0026auml;ss \u0026sect;\u0026nbsp;37 Abs.\u0026nbsp;1 Ziff.\u0026nbsp;1 bis Ziff.\u0026nbsp;8 StG betr\u0026auml;gt:\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[{"uid":"t-0--a-2--p-1--l-1‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      1.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      Fr.\u0026nbsp;0 bis Fr.\u0026nbsp;12'200 und 2\u0026nbsp;% f\u0026uuml;r den Mehrbetrag\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--a-2--p-1--l-2‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      2.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      Fr.\u0026nbsp;48 bis Fr.\u0026nbsp;14'600 und 3\u0026nbsp;% f\u0026uuml;r den Mehrbetrag\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--a-2--p-1--l-3‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      3.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      Fr.\u0026nbsp;114 bis Fr.\u0026nbsp;16'800 und 4\u0026nbsp;% f\u0026uuml;r den Mehrbetrag\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--a-2--p-1--l-4‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      4.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      Fr.\u0026nbsp;198 bis Fr.\u0026nbsp;18'900 und 5\u0026nbsp;% f\u0026uuml;r den Mehrbetrag\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--a-2--p-1--l-5‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      5.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      Fr.\u0026nbsp;303 bis Fr.\u0026nbsp;21'000 und 6\u0026nbsp;% f\u0026uuml;r den Mehrbetrag\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--a-2--p-1--l-6‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      6.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      Fr.\u0026nbsp;1'251 bis Fr.\u0026nbsp;36'800 und 7\u0026nbsp;% f\u0026uuml;r den Mehrbetrag\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--a-2--p-1--l-7‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      7.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      Fr.\u0026nbsp;4'583 bis Fr.\u0026nbsp;84'400 und 7.5\u0026nbsp;% f\u0026uuml;r den Mehrbetrag\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--a-2--p-1--l-8‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      8.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      Fr.\u0026nbsp;10'133 bis Fr.\u0026nbsp;158'400 und 8\u0026nbsp;% f\u0026uuml;r den Mehrbetrag\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]}],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--a-3","type":"article","number":{"de":"§\u0026nbsp;3"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003e\u0026sect;\u003c/span\u003e \u003cspan class='number'\u003e3\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eRundungsmethodik\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Rundungsmethodik"},"children":[{"uid":"t-0--a-3--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie indexierten Sozialabz\u0026uuml;ge sind auf Fr.\u0026nbsp;100 auf- oder abzurunden. Der nicht gerundete Betrag gilt als Basiswert f\u0026uuml;r die Berechnung des Folgejahres.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--a-3--p-2","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eBei der Indexierung des Einkommenssteuertarifs sind die steuerbaren Einkommen auf Fr.\u0026nbsp;100 abzurunden. Die einfache Steuer ist auf Fr.\u0026nbsp;0.05 auf- oder abzurunden.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]}]},"footer":{"de":"\u003cdiv class='egress_sign_off_date'\u003e\u003c/div\u003e\n\u003cdiv class='egress_sign_off_signature'\u003e\u003c/div\u003e\n\u003cdiv class='egress_sign_off_remarks'\u003e\u003c/div\u003e\n\u003cdiv class='egress_ags_source'\u003e\n  47/2022\n\u003c/div\u003e"},"annex_documents":{}},"footnotes":{"de":"\u003cdiv class='footnotes' id=''\u003e\n  \u003cdiv class='footnotes-hr'\u003e\u003c/div\u003e\n  \u003col\u003e\n    \u003cli\u003e\n      \u003ca class='footnote' href='#structured_documentingress_foundation_fn_14746_2_1' name='structured_documentingress_foundation_fn_14746_2_1_c' id=\"structured_documentingress_foundation_fn_14746_2_1_c\"\u003e[1]\u003c/a\u003e \u003cspan class='footnote_text'\u003eRB\u0026nbsp;\u003ca class=\"law_link\" href=\"https://www.rechtsbuch.tg.ch/data/640.1/de\" target=\"_blank\"\u003e640.1\u003c/a\u003e\u003c/span\u003e\n    \u003c/li\u003e\n  \u003c/ol\u003e\n\u003c/div\u003e"},"modification_table":[{"uid":"mt-0","type":"element","text":{"de":"Änderungstabelle - Nach Paragraph"},"html_content":{"de":"\u003ch1\u003e\n  \u0026Auml;nderungstabelle - Nach Paragraph\n\u003c/h1\u003e\n\u003ctable\u003e\n  \u003ctr\u003e\n    \u003cth\u003e\n      Element\n    \u003c/th\u003e\n    \u003cth\u003e\n      Beschluss\n    \u003c/th\u003e\n    \u003cth\u003e\n      Inkrafttreten\n    \u003c/th\u003e\n    \u003cth\u003e\n      \u0026Auml;nderung\n    \u003c/th\u003e\n    \u003cth\u003e\n      Amtsblatt\n    \u003c/th\u003e\n  \u003c/tr\u0
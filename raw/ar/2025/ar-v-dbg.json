iv class='enactment'\u003e\n  vom 26.09.2000 (Stand 01.01.2016)\n\u003c/div\u003e\n\u003cdiv class='ingress_author'\u003e\n  Der Regierungsrat des Kantons Appenzell A.Rh.,\n\u003c/div\u003e\n\u003cdiv class='ingress_foundation'\u003e\n  \u003cp\u003e\n    gest\u0026uuml;tzt auf Art. 104 Abs. 4 des Bundesgesetzes\u003ca class=\"footnote\" name=\"structured_documentingress_foundation_fn_4766_2_1\" href=\"#structured_documentingress_foundation_fn_4766_2_1_c\" id=\"structured_documentingress_foundation_fn_4766_2_1\"\u003e[1]\u003c/a\u003e vom 14. Dezember 1990 \u0026uuml;ber die direkte Bundessteuer (DBG) und Art. 286 Abs. 3 des Steuergesetzes\u003ca class=\"footnote\" name=\"structured_documentingress_foundation_fn_4766_2_2\" href=\"#structured_documentingress_foundation_fn_4766_2_2_c\" id=\"structured_documentingress_foundation_fn_4766_2_2\"\u003e[2]\u003c/a\u003e (StG) vom 21. Mai 2000,\n  \u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class='ingress_action'\u003e\n  verordnet:\n\u003c/div\u003e"},"content":{"uid":"t-0","type":"title","number":{},"html_content":{"de":""},"text":{},"children":[{"uid":"t-0--t-1‐","type":"title","number":{"de":"1."},"html_content":{"de":"\u003cdiv class='level_1 title'\u003e\n  \u003cspan class='number_discrete'\u003e(1.)\u003c/span\u003e \u003cspan class='title_text'\u003eI. Beh\u0026ouml;rden\u003c/span\u003e\n\u003c/div\u003e"},"text":{"de":"I. Behörden"},"children":[{"uid":"t-0--t-1‐--a-1","type":"article","number":{"de":"Art.\u0026nbsp;1"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eOrgane\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Organe"},"children":[{"uid":"t-0--t-1‐--a-1--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDer Vollzug des Bundesgesetzes \u0026uuml;ber die direkte Bundessteuer\u003ca class=\"footnote\" name=\"paragraphtext_content_fn_380082_2_3\" href=\"#paragraphtext_content_fn_380082_2_3_c\" id=\"paragraphtext_content_fn_380082_2_3\"\u003e[3]\u003c/a\u003e wird den folgenden Organen \u0026uuml;bertragen:\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[{"uid":"t-0--t-1‐--a-1--p-1--l-1‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      1.\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      der Kantonalen Steuerverwaltung;\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--t-1‐--a-1--p-1--l-2‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      2.\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      den Gemeindebeh\u0026ouml;rden;\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--t-1‐--a-1--p-1--l-3‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      3.\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      dem Obergericht.\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]}],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-1‐--a-2","type":"article","number":{"de":"Art.\u0026nbsp;2"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eDie Kantonale Steuerverwaltung\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Die Kantonale Steuerverwaltung"},"children":[{"uid":"t-0--t-1‐--a-2--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie Kantonale Steuerverwaltung\u003ca class=\"footnote\" name=\"paragraphtext_content_fn_380083_2_4\" href=\"#paragraphtext_content_fn_380083_2_4_c\" id=\"paragraphtext_content_fn_380083_2_4\"\u003e[4]\u003c/a\u003e amtet als kantonale Verwaltung f\u0026uuml;r die direkte Bundessteuer im Sinne des DBG, soweit diese Verordnung nicht etwas anderes bestimmt.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-1‐--a-3","type":"article","number":{"de":"Art.\u0026nbsp;3"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e3\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eDie Gemeindebeh\u0026ouml;rden\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Die Gemeindebehörden"},"children":[{"uid":"t-0--t-1‐--a-3--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDen Gemeindebeh\u0026ouml;rden obliegt der Vollzug des DBG insoweit, als sie f\u0026uuml;r das Mutationswesen und f\u0026uuml;r die Inventarisation in Todesf\u0026auml;llen nach kantonalem Recht zust\u0026auml;ndig sind.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-1‐--a-4","type":"article","number":{"de":"Art.\u0026nbsp;4"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e4\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eDas Obergericht\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Das Obergericht"},"children":[{"uid":"t-0--t-1‐--a-4--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDas Obergericht amtet als Steuerrekurskommission im Sinne von Art.\u0026nbsp;104\u0026nbsp;Abs.\u0026nbsp;3\u0026nbsp;DBG\u003ca class=\"footnote\" name=\"paragraphtext_content_fn_380085_2_5\" href=\"#paragraphtext_content_fn_380085_2_5_c\" id=\"paragraphtext_content_fn_380085_2_5\"\u003e[5]\u003c/a\u003e.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-1‐--a-5","type":"article","number":{"de":"Art.\u0026nbsp;5"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e5\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eOrganisation, Verfahren und Bezug\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Organisation, Verfahren und Bezug\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e"},"children":[{"uid":"t-0--t-1‐--a-5--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eSoweit Organisation, Verfahren und Bezug nicht bundesrechtlich geregelt sind, sind das kantonale Steuergesetz und seine Ausf\u0026uuml;hrungserlasse sinngem\u0026auml;ss anwendbar.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]}]},{"uid":"t-0--t-2‐","type":"title","number":{"de":"2."},"html_content":{"de":"\u003cdiv class='level_1 title'\u003e\n  \u003cspan class='number_discrete'\u003e(2.)\u003c/span\u003e \u003cspan class='title_text'\u003eII. Ordentliches Veranlagungsverfahren\u003c/span\u003e\n\u003c/div\u003e"},"text":{"de":"II. Ordentliches Veranlagungsverfahren"},"children":[{"uid":"t-0--t-2‐--a-6","type":"article","number":{"de":"Art.\u0026nbsp;6"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e6\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eRegisterf\u0026uuml;hrung, Meldepflichten\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Registerführung, Meldepflichten"},"children":[{"uid":"t-0--t-2‐--a-6--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie Einwohnerkontrollen erstellen die Meldungen \u0026uuml;ber Mutationen f\u0026uuml;r die steuerpflichtigen nat\u0026uuml;rlichen Personen zuhanden der Kantonalen Steuerverwaltung.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-2‐--a-6--p-2","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie Grundbuch\u0026auml;mter melden der Kantonalen Steuerverwaltung den Erwerb von Liegenschaften durch im Ausland domizilierte nat\u0026uuml;rliche und juristische Personen.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-2‐--a-7","type":"article","number":{"de":"Art.\u0026nbsp;7"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e7\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eSteuererkl\u0026auml;rung (Art.\u0026nbsp;124\u0026nbsp;Abs.\u0026nbsp;1\u0026nbsp;DBG)\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Steuererklärung (Art. 124 Abs. 1 DBG)"},"children":[{"uid":"t-0--t-2‐--a-7--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eIn allen F\u0026auml;llen, in denen sowohl kantonale als auch bundessteuerrechtliche Veranlagungen vorzunehmen sind, gelten die f\u0026uuml;r das kantonale Verfahren erstellten Formulare auch f\u0026uuml;r die Vornahme der Veranlagung f\u0026uuml;r die direkte Bundessteuer. Abweichungen gegen\u0026uuml;ber dem kantonalen Recht werden von Amtes wegen ber\u0026uuml;cksichtigt.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-2‐--a-8","type":"article","number":{"de":"Art.\u0026nbsp;8"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e8\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eVeranlagung der nat\u0026uuml;rlichen Personen; einj\u0026auml;hrige Steuerperiode (Art.\u0026nbsp;41\u0026nbsp;DBG)\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Veranlagung der natürlichen Personen; einjährige Steuerperiode (Art. 41 DBG)"},"children":[{"uid":"t-0--t-2‐--a-8--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie direkte Bundessteuer f\u0026uuml;r die nat\u0026uuml;rlichen Personen wird in Anwendung von Art.\u0026nbsp;41\u0026nbsp;DBG veranlagt und erhoben.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-2‐--a-9","type":"article","number":{"de":"Art.\u0026nbsp;9"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e9\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eEinsprache (Art.\u0026nbsp;132\u0026nbsp;DBG)\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Einsprache (Art. 132 DBG)"},"children":[{"uid":"t-0--t-2‐--a-9--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eEinsprachen sind bei der kantonalen Steuerverwaltung einzureichen.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-2‐--a-9--p-2","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eSoll eine Einsprache nach Massgabe von Art.\u0026nbsp;132\u0026nbsp;Abs.\u0026nbsp;2\u0026nbsp;DBG direkt dem Obergericht zum Entscheid unterbreitet werden (sog. Sprungbeschwerde), so holt die Veranlagungsbeh\u0026ouml;rde die allenfalls erforderliche Zustimmung ein und leitet die Sache an das Obergericht weiter.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]}]},{"uid":"t-0--t-3‐","type":"title","number":{"de":"3."},"html_content":{"de":"\u003cdiv class='level_1 title'\u003e\n  \u003cspan class='number_discrete'\u003e(3.)\u003c/span\u003e \u003cspan class='title_text'\u003eIII. Beschwerde\u003c/span\u003e\n\u003c/div\u003e"},"text":{"de":"III. Beschwerde"},"children":[{"uid":"t-0--t-3‐--a-10","type":"article","number":{"de":"Art.\u0026nbsp;10"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e10\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eAllgemeines\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Allgemeines"},"children":[{"uid":"t-0--t-3‐--a-10--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDas Obergericht ist einzige Beschwerdeinstanz.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-3‐--a-11","type":"article","number":{"de":"Art.\u0026nbsp;11"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e11\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eKosten (Art.\u0026nbsp;144\u0026nbsp;Abs.\u0026nbsp;5\u0026nbsp;DBG)\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Kosten (Art. 144 Abs. 5 DBG)"},"children":[{"uid":"t-0--t-3‐--a-11--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie Kosten des Verfahrens vor Obergericht werden nach den f\u0026uuml;r die kantonalen Steuern massgebenden Bestimmungen festgesetzt\u003ca class=\"footnote\" name=\"paragraphtext_content_fn_380094_2_6\" href=\"#paragraphtext_content_fn_380094_2_6_c\" id=\"paragraphtext_content_fn_380094_2_6\"\u003e[6]\u003c/a\u003e.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]}]},{"uid":"t-0--t-4‐","type":"title","number":{"de":"4."},"html_content":{"de":"\u003cdiv class='level_1 title'\u003e\n  \u003cspan class='number_discrete'\u003e(4.)\u003c/span\u003e \u003cspan class='title_text'\u003eIV. Quellensteuern\u003c/span\u003e\n\u003c/div\u003e"},"text":{"de":"IV. Quellensteuern"},"children":[{"uid":"t-0--t-4‐--a-12","type":"article","number":{"de":"Art.\u0026nbsp;12"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e12\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eVeranlagungs- und Rechtsmittelverfahren (Art.\u0026nbsp;139\u0026nbsp;Abs.\u0026nbsp;2\u0026nbsp;DBG)\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Veranlagungs- und Rechtsmittelverfahren (Art. 139 Abs. 2 DBG)"},"children":[{"uid":"t-0--t-4‐--a-12--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDas Veranlagungs- und Rechtsmittelverfahren richtet sich nach den f\u0026uuml;r die kantonal-rechtlichen Quellensteuern massgebenden kantonalen Verfahrensvorschriften\u003ca class=\"footnote\" name=\"paragraphtext_content_fn_380095_2_7\" href=\"#paragraphtext_content_fn_380095_2_7_c\" id=\"paragraphtext_content_fn_380095_2_7\"\u003e[7]\u003c/a\u003e.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]}]},{"uid":"t-0--t-5‐","type":"title","number":{"de":"5."},"html_content":{"de":"\u003cdiv class='level_1 title'\u003e\n  \u003cspan class='number_discrete'\u003e(5.)\u003c/span\u003e \u003cspan class='title_text'\u003eV. Steuerbezug und Steuersicherung\u003c/span\u003e\n\u003c/div\u003e"},"text":{"de":"V. Steuerbezug und Steuersicherung"},"children":[{"uid":"t-0--t-5‐--a-13","type":"article","number":{"de":"Art.\u0026nbsp;13"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e13\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eZeitpunkte (Art.\u0026nbsp;161\u0026nbsp;Abs.\u0026nbsp;1\u0026nbsp;DBG)\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Zeitpunkte (Art. 161 Abs. 1 DBG)\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e"},"children":[{"uid":"t-0--t-5‐--a-13--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie Steuern werden j\u0026auml;hrlich durch die Kantonale Steuerverwaltung bezogen.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-5‐--a-14","type":"article","number":{"de":"Art.\u0026nbsp;14"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e14\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eEintrag im Grundbuch (Art.\u0026nbsp;172\u0026nbsp;DBG)\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Eintrag im Grundbuch (Art. 172 DBG)"},"children":[{"uid":"t-0--t-5‐--a-14--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie Grundbuch\u0026auml;mter d\u0026uuml;rfen die \u0026Uuml;bertragung des Eigentums an einer Liegenschaft einer im Ausland ans\u0026auml;ssigen nat\u0026uuml;rlichen oder juristischen Person im Grundbuch erst mit schriftlicher Zustimmung der Kantonalen Steuerverwaltung vornehmen.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-5‐--a-14--p-2","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie Kantonale Steuerverwaltung bescheinigt dem Ver\u0026auml;usserer zuhanden des Grundbuchamtes die Zustimmung zum Eintrag oder die Ablehnung.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-5‐--a-15","type":"article","number":{"de":"Art.\u0026nbsp;15"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e15\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eL\u0026ouml;schung einer Firma im Handelsregister (Art.\u0026nbsp;171\u0026nbsp;DBG)\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Löschung einer Firma im Handelsregister (Art. 171 DBG)"},"children":[{"uid":"t-0--t-5‐--a-15--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDas Handelsregisteramt gibt der Kantonalen Steuerverwaltung von jeder Meldung der L\u0026ouml;schung einer juristischen Person Kenntnis.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]}]},{"uid":"t-0--t-6‐","type":"title","number":{"de":"6."},"html_content":{"de":"\u003cdiv class='level_1 title'\u003e\n  \u003cspan class='number_discrete'\u003e(6.)\u003c/span\u003e \u003cspan class='title_text'\u003eVI. Steuererlass\u003c/span\u003e\n\u003c/div\u003e"},"text":{"de":"VI. Steuererlass"},"children":[{"uid":"t-0--t-6‐--a-16","type":"article","number":{"de":"Art.\u0026nbsp;16"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e16\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eKantonale Kompetenz (Art. 167b Abs. 1\u0026nbsp;DBG)\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Kantonale Kompetenz (Art. 167b Abs. 1 DBG)\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e"},"children":[{"uid":"t-0--t-6‐--a-16--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDer Entscheid \u0026uuml;ber Erlasse obliegt der gem\u0026auml;ss kantonalem Recht f\u0026uuml;r den Steuererlass zust\u0026auml;ndigen Stelle\u003ca class=\"footnote\" name=\"paragraphtext_content_fn_380100_2_8\" href=\"#paragraphtext_content_fn_380100_2_8_c\" id=\"paragraphtext_content_fn_380100_2_8\"\u003e[8]\u003c/a\u003e.\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-6‐--a-16--p-2","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='abrogation_ellip'\u003e\u0026hellip;\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-6‐--a-17","type":"article","number":{"de":"Art.\u0026nbsp;17\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e17\u0026nbsp;\u003cstrong\u003e*\u003c/strong\u003e\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u0026hellip;\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"\u0026hellip;"}}]},{"uid":"t
"t-0--t-4‐--a-20--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDieses Gesetz wird ab 1. Januar 2001 angewendet.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]}]}]},"footer":{"de":"\u003cdiv class='egress_sign_off_date'\u003e\u003c/div\u003e\n\u003cdiv class='egress_sign_off_signature'\u003e\u003c/div\u003e\n\u003cdiv class='egress_sign_off_remarks'\u003e\n  \u003cp\u003e\n    Die Regierung des Kantons St.Gallen\n  \u003c/p\u003e\n  \u003cp\u003e\n    erkl\u0026auml;rt:\u003ca class=\"footnote\" name=\"structured_documentegress_sign_off_remarks_fn_2753_2_18\" href=\"#structured_documentegress_sign_off_remarks_fn_2753_2_18_c\" id=\"structured_documentegress_sign_off_remarks_fn_2753_2_18\"\u003e[18]\u003c/a\u003e\n  \u003c/p\u003e\n  \u003cp\u003e\n    Das Gesetz \u0026uuml;ber die Durchf\u0026uuml;hrung der Grundst\u0026uuml;cksch\u0026auml;tzung wurde am 9.\u0026nbsp;November 2000 rechtsg\u0026uuml;ltig, nachdem innerhalb der Referendumsfrist vom 10.\u0026nbsp;Oktober bis 8.\u0026nbsp;November 2000 kein Begehren um Anordnung einer Volksabstimmung gestellt worden ist.\u003ca class=\"footnote\" name=\"structured_documentegress_sign_off_remarks_fn_2753_2_19\" href=\"#structured_documentegress_sign_off_remarks_fn_2753_2_19_c\" id=\"structured_documentegress_sign_off_remarks_fn_2753_2_19\"\u003e[19]\u003c/a\u003e\n  \u003c/p\u003e\n  \u003cp\u003e\n    Das Gesetz wird ab 1.\u0026nbsp;Januar 2001 angewendet.\n  \u003c/p\u003e\n\u003c/div\u003e\n\u003cdiv class='egress_ags_source'\u003e\n  nGS 35\u0026ndash;64\n\u003c/div\u003e"},"annex_documents":{}},"footnotes":{"de":"\u003cdiv class='footnotes' id=''\u003e\n  \u003cdiv class='footnotes-hr'\u003e\u003c/div\u003e\n  \u003col\u003e\n    \u003cli\u003e\n      \u003ca class='footnote' href='#structured_documentingress_foundation_fn_2753_2_1' name='structured_documentingress_foundation_fn_2753_2_1_c' id=\"structured_documentingress_foundation_fn_2753_2_1_c\"\u003e[1]\u003c/a\u003e \u003cspan class='footnote_text'\u003eABl 2000, 501 ff.\u003c/span\u003e\n    \u003c/li\u003e\n    \u003cli\u003e\n      \u003ca class='footnote' href='#structured_documentingress_action_fn_2753_2_2' name='structured_documentingress_action_fn_2753_2_2_c' id=\"structured_documentingress_action_fn_2753_2_2_c\"\u003e[2]\u003c/a\u003e \u003cspan class='footnote_text'\u003eAbgek\u0026uuml;rzt GGS. Vom Grossen Rat erlassen am 27. September; nach unben\u0026uuml;tzter Referendumsfrist rechtsg\u0026uuml;ltig geworden am 9. November 2000; in Vollzug ab 1. Januar 2001.\u003c/span\u003e\n    \u003c/li\u003e\n    \u003cli\u003e\n      \u003ca class='footnote' href='#enumeration_itemtext_content_fn_20123_2_3' name='enumeration_itemtext_content_fn_20123_2_3_c' id=\"enumeration_itemtext_content_fn_20123_2_3_c\"\u003e[3]\u003c/a\u003e \u003cspan class='footnote_text'\u003esGS \u003ca class=\"law_link\" href=\"https://www.gesetzessammlung.sg.ch/data/811.1/de\" target=\"_blank\"\u003e811.1\u003c/a\u003e.\u003c/span\u003e\n    \u003c/li\u003e\n    \u003cli\u003e\n      \u003ca class='footnote' href='#enumeration_itemtext_content_fn_20124_2_4' name='enumeration_itemtext_content_fn_20124_2_4_c' id=\"enumeration_itemtext_content_fn_20124_2_4_c\"\u003e[4]\u003c/a\u003e \u003cspan class='footnote_text'\u003esGS \u003ca class=\"law_link\" href=\"https://www.gesetzessammlung.sg.ch/data/873.1/de\" target=\"_blank\"\u003e873.1\u003c/a\u003e.\u003c/span\u003e\n    \u003c/li\u003e\n    \u003cli\u003e\n      \u003ca class='footnote' href='#enumeration_itemtext_content_fn_20125_2_5' name='enumeration_itemtext_content_fn_20125_2_5_c' id=\"enumeration_itemtext_content_fn_20125_2_5_c\"\u003e[5]\u003c/a\u003e \u003cspan class='footnote_text'\u003eSR 211.412.11.\u003c/span\u003e\n    \u003c/li\u00
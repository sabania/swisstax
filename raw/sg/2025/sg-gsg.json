table\u003e"},"children":[]},{"uid":"t-0--t-1‐--a-2--p-1--l-b‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      b)\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      Geb\u0026auml;ude, die nach dem Gesetz \u0026uuml;ber die Geb\u0026auml;udeversicherung\u003ca class=\"footnote\" name=\"enumeration_itemtext_content_fn_20128_2_8\" href=\"#enumeration_itemtext_content_fn_20128_2_8_c\" id=\"enumeration_itemtext_content_fn_20128_2_8\"\u003e[8]\u003c/a\u003e bei der Geb\u0026auml;udeversicherungsanstalt zu versichern sind;\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--t-1‐--a-2--p-1--l-c‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      c)\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      Korporationsteilrechte und \u0026auml;hnliche Nutzungsrechte des kantonalen Rechts.\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]}],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]}]},{"uid":"t-0--t-2‐","type":"title","number":{"de":"2."},"html_content":{"de":"\u003cdiv class='level_1 title'\u003e\n  \u003cspan class='number_discrete'\u003e(2.)\u003c/span\u003e \u003cspan class='title_text'\u003eII. Durchf\u0026uuml;hrung\u003c/span\u003e\n\u003c/div\u003e"},"text":{"de":"II. Durchführung"},"children":[{"uid":"t-0--t-2‐--a-3","type":"article","number":{"de":"Art.\u0026nbsp;3"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e3\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eZust\u0026auml;ndigkeit\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Zuständigkeit"},"children":[{"uid":"t-0--t-2‐--a-3--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDer Staat f\u0026uuml;hrt die Grundst\u0026uuml;cksch\u0026auml;tzung durch. Die politischen Gemeinden wirken mit.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-2‐--a-3--p-2","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie Regierung regelt die Aufgaben der durchf\u0026uuml;hrenden Stellen durch Verordnung.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-2‐--a-3--p-3","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e3\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eSie kann die zust\u0026auml;ndige Stelle des Staates der Geb\u0026auml;udeversicherungsanstalt angliedern.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-2‐--a-4","type":"article","number":{"de":"Art.\u0026nbsp;4"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e4\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eSch\u0026auml;tzungsvorschriften\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Schätzungsvorschriften"},"children":[{"uid":"t-0--t-2‐--a-4--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie Sch\u0026auml;tzung eines Objektes richtet sich nach den in Art. 1 dieses Gesetzes genannten Erlassen und Bestimmungen.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-2‐--a-5","type":"article","number":{"de":"Art.\u0026nbsp;5"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e5\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eBesichtigung\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Besichtigung"},"children":[{"uid":"t-0--t-2‐--a-5--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eBei der erstmaligen Sch\u0026auml;tzung und der Neubeurteilung der Sch\u0026auml;tzung wird das Objekt besichtigt.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-2‐--a-6","type":"article","number":{"de":"Art.\u0026nbsp;6"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e6\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eNeubeurteilung\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Neubeurteilung"},"children":[{"uid":"t-0--t-2‐--a-6--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eEine Neubeurteilung der Sch\u0026auml;tzung erfolgt:\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[{"uid":"t-0--t-2‐--a-6--p-1--l-a‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      a)\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      in der Regel alle zehn Jahre;\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--t-2‐--a-6--p-1--l-b‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      b)\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      auf Antrag des Eigent\u0026uuml;mers;\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--t-2‐--a-6--p-1--l-c‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      c)\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      nach einer wesentlichen Ver\u0026auml;nderung der wertbestimmenden Eigenschaften eines Objektes.\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]}],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-2‐--a-6--p-2","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDer Eigent\u0026uuml;mer reicht das Begehren um Neubeurteilung beim zust\u0026auml;ndigen Grundbuchamt schriftlich ein.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-2‐--a-7","type":"article","number":{"de":"Art.\u0026nbsp;7"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e7\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eMitwirkung des Eigent\u0026uuml;mers\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Mitwirkung des Eigentümers"},"children":[{"uid":"t-0--t-2‐--a-7--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDer Eigent\u0026uuml;mer eines Geb\u0026auml;udes erstattet dem zust\u0026auml;ndigen Grundbuchamt Meldung, wenn:\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[{"uid":"t-0--t-2‐--a-7--p-1--l-a‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      a)\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      die Errichtung eines neuen Geb\u0026auml;udes vollendet ist;\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--t-2‐--a-7--p-1--l-b‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      b)\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      an einem bestehenden Geb\u0026auml;ude bauliche \u0026Auml;nderungen, welche die Sch\u0026auml;tzung des Objektes beeinflussen, vorgenommen worden sind.\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]}],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-2‐--a-7--p-2","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDer Eigent\u0026uuml;mer eines Sch\u0026auml;tzungsobjektes stellt sicher, dass die f\u0026uuml;r die Sch\u0026auml;tzung zust\u0026auml;ndigen Personen Zutritt zu allen Grundst\u0026uuml;ckteilen und R\u0026auml;umlichkeiten haben, und erteilt die erforderlichen Ausk\u0026uuml;nfte.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-2‐--a-8","type":"article","number":{"de":"Art.\u0026nbsp;8"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e8\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eEr\u0026ouml;ffnung der Sch\u0026auml;tzungsergebnisse\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Eröffnung der Schätzungsergebnisse"},"children":[{"uid":"t-0--t-2‐--a-8--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie Steuerwerte werden vom Gemeindesteueramt er\u0026ouml;ffnet, die Geb\u0026auml;udeversicherungswerte im Auftrag der Geb\u0026auml;udeversicherungsanstalt vom Grundbuchamt.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-2‐--a-9","type":"article","number":{"de":"Art.\u0026nbsp;9"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e9\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eBekanntgabe der Sch\u0026auml;tzung\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Bekanntgabe der Schätzung"},"children":[{"uid":"t-0--t-2‐--a-9--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie rechtskr\u0026auml;ftigen Sch\u0026auml;tzungsergebnisse werden Dritten bekannt gegeben, wenn diese ein schutzw\u0026uuml;rdiges Interesse glaubhaft machen.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-2‐--a-9--p-2","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eEigent\u0026uuml;mern, Grundpfandgl\u0026auml;ubigern und B\u0026uuml;rgen von Grundpfandforderungen wird Einsicht in die Sch\u0026auml;tzungsunterlagen gew\u0026auml;hrt und auf Verlangen eine Kopie ausgeh\u0026auml;ndigt.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]}]},{"uid":"t-0--t-3‐","type":"title","number":{"de":"3."},"html_content":{"de":"\u003cdiv class='level_1 title'\u003e\n  \u003cspan class='number_discrete'\u003e(3.)\u003c/span\u003e \u003cspan class='title_text'\u003eIII. Kosten\u003c/span\u003e\n\u003c/div\u003e"},"text":{"de":"III. Kosten"},"children":[{"uid":"t-0--t-3‐--a-10","type":"article","number":{"de":"Art.\u0026nbsp;10"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e10\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eStaat und Gemeinden\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Staat und Gemeinden"},"children":[{"uid":"t-0--t-3‐--a-10--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eStaat und politische Gemeinden tragen ihre Kosten f\u0026uuml;r die Durchf\u0026uuml;hrung der Grundst\u0026uuml;cksch\u0026auml;tzung.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-3‐--a-11","type":"article","number":{"de":"Art.\u0026nbsp;11"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e11\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eGeb\u0026auml;udeversicherungsanstalt\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Gebäudeversicherungsanstalt"},"children":[{"uid":"t-0--t-3‐--a-11--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie Geb\u0026auml;udeversicherungsanstalt leistet dem Staat und den politischen Gemeinden f\u0026uuml;r die Durchf\u0026uuml;hrung der Grundst\u0026uuml;cksch\u0026auml;tzung eine j\u0026auml;hrliche Entsch\u0026auml;digung.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-3‐--a-11--p-2","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie H\u0026ouml;he der Entsch\u0026auml;digung richtet sich nach:\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[{"uid":"t-0--t-3‐--a-11--p-2--l-a‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      a)\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      der H\u0026ouml;he der direkt der Durchf\u0026uuml;hrung der Grundst\u0026uuml;cksch\u0026auml;tzung zuzuordnenden laufenden Aufwendungen;\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--t-3‐--a-11--p-2--l-b‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      b)\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      dem anteilm\u0026auml;ssigen Nutzen f\u0026uuml;r die Geb\u0026auml;udeversicherungsanstalt.\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]}],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-3‐--a-11--p-3","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e3\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie Regierung regelt die Einzelheiten der Entsch\u0026auml;digung durch Verordnung.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]},{"uid":"t-0--t-3‐--a-12","type":"article","number":{"de":"Art.\u0026nbsp;12"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e12\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003eGrundeigent\u0026uuml;mer\u003c/span\u003e\n  \u003c/div\u003e\n\u003c/div\u003e"},"text":{"de":"Grundeigentümer"},"children":[{"uid":"t-0--t-3‐--a-12--p-1","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e1\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDer Eigent\u0026uuml;mer entrichtet eine Geb\u0026uuml;hr, wenn:\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[{"uid":"t-0--t-3‐--a-12--p-1--l-a‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      a)\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      die Grundst\u0026uuml;cksch\u0026auml;tzung nach Art. 87 Abs. 1 und 2 des Bundesgesetzes \u0026uuml;ber das b\u0026auml;uerliche Bodenrecht vom 4.\u0026nbsp;Oktober 1991\u003ca class=\"footnote\" name=\"enumeration_itemtext_content_fn_20137_2_9\" href=\"#enumeration_itemtext_content_fn_20137_2_9_c\" id=\"enumeration_itemtext_content_fn_20137_2_9\"\u003e[9]\u003c/a\u003e erfolgt;\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--t-3‐--a-12--p-1--l-b‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      b)\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      die Besichtigung des Sch\u0026auml;tzungsobjektes\u003ca class=\"footnote\" name=\"enumeration_itemtext_content_fn_20138_2_10\" href=\"#enumeration_itemtext_content_fn_20138_2_10_c\" id=\"enumeration_itemtext_content_fn_20138_2_10\"\u003e[10]\u003c/a\u003e aus Gr\u0026uuml;nden, die der Eigent\u0026uuml;mer zu verantworten hat, nicht wie vorgesehen durchgef\u0026uuml;hrt werden kann;\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]},{"uid":"t-0--t-3‐--a-12--p-1--l-c‐","type":"enumeration","html_content":{"de":"\u003ctable class='enumeration_item'\u003e\n  \u003ctr\u003e\n    \u003ctd class='number'\u003e\n      c)\n    \u003c/td\u003e\n    \u003ctd class='left_col last' colspan='3'\u003e\n      er eine Neubeurteilung\u003ca class=\"footnote\" name=\"enumeration_itemtext_content_fn_20139_2_11\" href=\"#enumeration_itemtext_content_fn_20139_2_11_c\" id=\"enumeration_itemtext_content_fn_20139_2_11\"\u003e[11]\u003c/a\u003e verlangt und diese keine \u0026Auml;nderung der Sch\u0026auml;tzung ergibt.\n    \u003c/td\u003e\n  \u003c/tr\u003e\n\u003c/table\u003e"},"children":[]}],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}},{"uid":"t-0--t-3‐--a-12--p-2","type":"paragraph","html_content":{"de":"\u003cdiv class='paragraph'\u003e\n  \u003cspan class='number'\u003e2\u003c/span\u003e\n  \u003cp\u003e\n    \u003cspan class='text_content'\u003eDie Regierung bestimmt die Geb\u0026uuml;hren durch Verordnung.\u003c/span\u003e\n  \u003c/p\u003e\n\u003c/div\u003e"},"children":[],"html_content_post":{"de":"\u003cdiv class='paragraph_post'\u003e\u003c/div\u003e"}}]}]},{"uid":"t-0--t-4‐","type":"title","number":{"de":"4."},"html_content":{"de":"\u003cdiv class='level_1 title'\u003e\n  \u003cspan class='number_discrete'\u003e(4.)\u003c/span\u003e \u003cspan class='title_text'\u003eIV. Schlussbestimmungen\u003c/span\u003e\n\u003c/div\u003e"},"text":{"de":"IV. Schlussbestimmungen"},"children":[{"uid":"t-0--t-4‐--a-13","type":"article","number":{"de":"Art.\u0026nbsp;13"},"html_content":{"de":"\u003cdiv class='article'\u003e\n  \u003cdiv class='article_number'\u003e\n    \u003cspan class='article_symbol'\u003eArt.\u003c/span\u003e \u003cspan class='number'\u003e13\u003c/span\u003e\n  \u003c/div\u003e\n  \u003cdiv class='article_title'\u003e\n    \u003cspan class='title_text'\u003e\u003ca class
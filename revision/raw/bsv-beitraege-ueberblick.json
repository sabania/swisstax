"text"}]},{"type":"td","orientation":"left","cellContent":[{"text":"<strong>530</strong>","contentType":"text"}]},{"type":"td","orientation":"left","cellContent":[{"text":"<strong>26 500</strong>","contentType":"text"}]}],[{"type":"td","orientation":"left","cellContent":[{"text":"ALV<sup>1,2</sup>","contentType":"text"}]},{"type":"td","orientation":"left","cellContent":[{"text":"--","contentType":"text"}]},{"type":"td","orientation":"left","cellContent":[{"text":"--","contentType":"text"}]}],[{"type":"td","orientation":"left","cellContent":[{"text":"BV<sup>3</sup>","contentType":"text"}]},{"type":"td","orientation":"left","cellContent":[{"text":"--","contentType":"text"}]},{"type":"td","orientation":"left","cellContent":[{"text":"--","contentType":"text"}]}],[{"type":"td","orientation":"left","cellContent":[{"text":"FamZ<sup>4</sup>","contentType":"text"}]},{"type":"td","orientation":"left","cellContent":[{"text":"--","contentType":"text"}]},{"type":"td","orientation":"left","cellContent":[{"text":"--","contentType":"text"}]}],[{"type":"td","orientation":"left","cellContent":[{"text":"BUV<sup>1,5</sup>","contentType":"text"}]},{"type":"td","orientation":"left","cellContent":[{"text":"--","contentType":"text"}]},{"type":"td","orientation":"left","cellContent":[{"text":"--","contentType":"text"}]}],[{"type":"td","orientation":"left","cellContent":[{"text":"NBUV<sup>5</sup>","contentType":"text"}]},{"type":"td","orientation":"left","cellContent":[{"text":"--","contentType":"text"}]},{"type":"td","orientation":"left","cellContent":[{"text":"--","contentType":"text"}]}]],"variant":"default","sortIndex":null,"defaultSorting":"ascending","footerRow":null,"componentId":"doc-1j5ed2ll20"},"identifier":"table","id":"doc-1j5ed2ll20"}]}]},{"properties":{"heading":"h2","label":"Beiträge von Arbeitgebern und Arbeitnehmenden","class":"","anchorNav":"Beiträge-von-Arbeitgebern-und-Arbeitnehmenden"},"identifier":"heading-h2","id":"Beiträge-von-Arbeitgebern-und-Arbeitnehmenden"},{"properties":{"text":"Der Arbeitgeber bezahlt die Sozialversicherungsbeiträge an seine Ausgleichskasse, seine Vorsorgeeinrichtung (Pensionskasse) und seinen Unfallversicherer. Auf den Löhnen, die er den Arbeitnehmenden bezahlt, erhebt der Arbeitgeber den Beitrags- und Prämienanteil, den die Angestellten übernehmen müssen."},"identifier":"p","id":"doc-1j30paf7d0"},{"properties":{"text":"Mit den nachfolgenden Berechnungsmodulen können Lohnberechnungen erstellt werden. Es handelt sich um einfache Beispiele, die nicht für Lohnabrechnungen der Arbeitgeber für Arbeitnehmende verwendet werden können. In der Praxis müssen auch die nach kantonalem Recht und gemäss den Verträgen zwischen Arbeitgebern und Arbeitnehmenden geschuldeten Beiträge berücksichtigt werden."},"identifier":"p","id":"doc-1j30pas2j0"},{"properties":{"text":"<strong>Lohnabrechnungen (Onlinerechner)</strong>"},"identifier":"p","id":"doc-1j8kvcm000"},{"properties":{"accordionSettings":"closed"},"identifier":"accordion-container","id":"doc-1j8kubfbe0","nestedContent":[{"properties":{"accordionItems":{"title":"Abrechnung im Monatslohn"}},"identifier":"accordion-item","id":"doc-1j8kubfbe1","nestedContent":[{"properties":{"title":"Abrechnung im Monatslohn","src":"https://rechner.soziale-sicherheit-chss.ch/monatslohn","classAttributes":"ratio ratio--1/1","width":"100%","height":"100%","allowFullScreen":true,"loading":"lazy","sizingMode":"fixed","legend":""},"identifier":"iframe","id":"doc-1j8kuc7as0"}]},{"properties":{"accordionItems":{"title":"Abrechnung im Stundenlohn"}},"identifier":"accordion-item","id":"doc-1j8kvedg50","nestedContent":[{"properties":{"title":"","src":"https://rechner.soziale-sicherheit-chss.ch/stundenlohn","classAttributes":"ratio ratio--1/1","width":"100%","height":"100%","allowFullScreen":true,"loading":"lazy","sizingMode":"fixed","legend":""},"identifier":"iframe","id":"doc-1j8kvgfu80"}]}]},{"properties":{"text":"Für kurzfristige oder im Umfang geringe Arbeitsverhältnisse (wie zum Beispiel in Privathaushalten) können Arbeitgeber bei ihrer Ausgleichskasse das <a href=\"https://www.ahv-iv.ch/p/2.07.d\" target=\"_self\" rel=\"external\" class=\"link--external\" aria-label=\"vereinfachte Abrechnungsverfahren\">vereinfachte Abrechnungsverfahren</a> für AHV/IV/EO/ALV/FamZ-Beiträge sowie die Quellensteuer verwenden."},"identifier":"p","id":"doc-1j30pc96l0"},{"properties":{"text":"Für in Privathaushalten beschäftigte Personen kann auch die Unfallversicherung über die Ausgleichskasse abgeschlossen werden («<a href=\"https://www.ahv-iv.ch/p/2.07.d\" target=\"_self\" rel=\"external\" class=\"link--external\" aria-label=\"vereinfachtes Abrechnungsverfahren Plus\">vereinfachtes Abrechnungsverfahren Plus</a>»)."},"identifier":"p","id":"doc-1j30pm3li0"},{"properties":{"text":"Weitere Informationen finden Sie in den Dokumenten auf folgenden Internetseiten:"},"identifier":"p","id":"doc-1j30pn47p0"},{"properties":{"text":"<a href=\"https://www.ahv-iv.ch/de/Merkbl%C3%A4tter/Beitr%C3%A4ge-AHV-IV-EO-ALV\" target=\"_self\" rel=\"external\" class=\"link--external\" aria-label=\"Merkblätter der Infostelle AHV/IV zu den Beiträgen AHV/IV/EO/ALV\">Merkblätter der Infostelle AHV/IV zu den Beiträgen AHV/IV/EO/ALV</a>"},"identifier":"p","id":"doc-1j30pnioc0"},{"properties":{"text":"<a href=\"https://www.ahv-iv.ch/de/Merkbl%C3%A4tter/Familienzulagen\" target=\"_self\" rel=\"external\" class=\"link--external\" aria-label=\"Merkblätter der Infostelle AHV/IV zu den Familienzulagen\">Merkblätter der Infostelle AHV/IV zu den Familienzulagen</a>"},"identifier":"p","id":"doc-1j30pniod0"},{"properties":{"text":"<a href=\"https://www.ahv-iv.ch/de/Merkbl%C3%A4tter/Andere-Sozialversicherungen\" target=\"_self\" rel=\"external\" class=\"link--external\" aria-label=\"Merkblätter der Infostelle AHV/IV zur obligatorischen Unfallversicherung\">Merkblätter der Infostelle AHV/IV zur obligatorischen Unfallversicherung</a>"},"identifier":"p","id":"doc-1j30pniod1"},{"properties":{"text":"<a href=\"https://www.ahv-iv.ch/de/Merkbl%C3%A4tter/Andere-Sozialversicherungen\" target=\"_self\" rel=\"external\" class=\"link--external\" aria-label=\"Merkblätter der Infostelle AHV/IV zur beruflichen Vorsorge\">Merkblätter der Infostelle AHV/IV zur beruflichen Vorsorge</a>"},"identifier":"p","id":"doc-1j30pnioe0"},{"properties":{"text":"<a href=\"https://sozialversicherungen.admin.ch/de/f/5621\" target=\"_self\" rel=\"external\" class=\"link--external\" aria-label=\"Weisungen des BSV zuhanden der Ausgleichskassen zu den Beiträgen AHV/IV/EO/ALV\">Weisungen des BSV zuhanden der Ausgleichskassen zu den Beiträgen AHV/IV/EO/ALV</a>"},"identifier":"p","id":"doc-1j30pnioe1"},{"properties":{"text":"<a href=\"https://sozialversicherungen.admin.ch/de/f/5599\" target=\"_self\" rel=\"external\" class=\"link--external\" aria-label=\"Weisungen des BSV zuhanden der Ausgleichskassen zu den Familienzulagen\">Weisungen des BSV zuhanden der Ausgleichskassen zu den Familienzulagen</a>"},"identifier":"p","id":"doc-1jcooa28o0"},{"properties":{"heading":"h2","label":"Beiträge von Selbständigerwerbenden","class":"","anchorNav":"Beiträge-von-Selbständigerwerbenden"},"identifier":"heading-h2","id":"Beiträge-von-Selbständigerwerbenden"},{"properties":{"text":"Selbstständigerwerbende bezahlen selber ihre gesamten Beiträge bei Ihrer Ausgleichskasse und ‒ wenn sie sich für einen Versicherungsbeitritt entscheiden ‒ bei der Vorsorgeeinrichtung und beim Unfallversicherer ihrer Wahl. Für Jahreseinkommen von unter 60 500 Franken, aber mindestens 10 100 Franken, berechnet sich der AHV-/IV-/EO-Beitragssatz nach einer sinkenden Beitragsskala. Bei einem Einkommen ab 60 500 Franken pro Jahr kommt der maximale AHV-/IV-/EO-Beitragssatz zur Anwendung. Selbstständigerwerbende mit einem Jahreseinkommen von 10 100 Franken oder weniger bezahlen den AHV-/IV-/EO-Mindestbeitrag von 530 Franken pro Jahr. Das beitragspflichtige Nettoeinkommen wird von den Steuerbehörden ermittelt und den Ausgleichskassen gemeldet."},"identifier":"p","id":"doc-1jcogqla40"},{"properties":{"text":"Weitere Informationen zu den Beiträgen und Leistungen für Selbstständigerwerbende sind auf folgender Internetseite zu finden: <a href=\"/de/selbststaendigkeit\" target=\"_self\" class=\"link\" aria-label=\"Was ist bei Selbstständigkeit zu beachten?\">Was ist bei Selbstständigkeit zu beachten?</a>"},"identifier":"p","id":"doc-1jcogtcqc0"},{"properties":{"text":"Selbstständigerwerbende können die Aufnahme ihrer Tätigkeit bei der zuständigen Ausgleichskasse auf der Webseite <a target=\"_blank\" href=\"https://selbststaendig-erwerbend.ch/\" rel=\"external\" class=\"link--external\" aria-label=\"www.selbststaendig-erwerbend.ch Link in neuem Tab öffnen\">www.selbststaendig-erwerbend.ch</a> anmelden, die ausserdem umfangreiche Informationen zur Selbstständigkeit liefert."},"identifier":"p","id":"doc-1jcogs12e0"},{"properties":{"text":"Mit dem nachfolgenden Berechnungsmodul können Beitragsberechnungen erstellt werden. Dabei handelt es sich lediglich um Richtwerte."},"identifier":"p","id":"doc-1jcoguf8s0"},{"properties":{"accordionSettings":"closed"},"identifier":"accordion-container","id":"doc-1j8ku0d0d0","nestedContent":[{"properties":{"accordionItems":{"title":"Beitragsberechnung für Selbstständigerwerbende (Onlinerechner)"}},"identifier":"accordion-item","id":"doc-1j8ku0d0e0","nestedContent":[{"properties":{"title":"","src":"https://rechner.soziale-sicherheit-chss.ch/selbstaendigerwerbende","classAttributes":"ratio ratio--1/1","width":"100%","height":"100%","allowFullScreen":true,"loading":"lazy","sizingMode":"fixed","legend":""},"identifier":"iframe","id":"doc-1j8ku1n1c0"}]}]},{"properties":{"text":"Weitere Informationen finden Sie in den Dokumenten auf folgenden Internetseiten:"},"identifier":"p","id":"doc-1j30pq77p0"},{"properties":{"text":"<a href=\"https://www.ahv-iv.ch/de/Merkbl%C3%A4tter/Beitr%C3%A4ge-AHV-IV-EO-ALV\" target=\"_self\" rel=\"external\" class=\"link--external\" aria-label=\"Merkblätter der Infostelle AHV/IV \">Merkblätter der Infostelle AHV/IV </a>"},"identifier":"p","id":"doc-1j30pq77p1"},{"properties":{"text":"<a href=\"https://sozialversicherungen.admin.ch/de/f/5621\" target=\"_self\" rel=\"external\" class=\"link--external\" aria-label=\"Weisungen und Beitragstabellen des BSV zuhanden der Ausgleichskassen \">Weisungen und Beitragstabellen des BSV zuhanden der Ausgleichskassen </a>"},"identifier":"p","id":"doc-1j30pq77p2"},{"properties":{"text":"<a target=\"_blank\" href=\"https://sozialversicherungen.admin.ch/de/d/21883\" rel=\"external\" class=\"link--external\" aria-label=\"AHV/EL Mitteilung Nr. 504 (Zinsabzug auf dem investierten Eigenkapital 2025) Link in neuem Tab öffnen\">AHV/EL Mitteilung Nr. 504 (Zinsabzug auf dem investierten Eigenkapital 2025)</a>"},"identifier":"p","id":"doc-1j30pq77p3"},{"properties":{"heading":"h2","label":"Beiträge von Nichterwerbstätigen","class":"","anchorNav":"Beiträge-von-Nichterwerbstätigen"},"identifier":"heading-h2","id":"Beiträge-von-Nichterwerbstätigen"},{"properties":{"text":"Auch Nichterwerbstätige müssen Beiträge an die AHV/IV/EO bezahlen. Personen, die Teilzeit oder nur während eines Teils des Jahres arbeiten, sind teilweise wie eine nichterwerbstätige Person beitragspflichtig. Die Beitragshöhe richtet sich nach dem Vermögen, über das sie am 31. Dezember des Beitragsjahres verfügen und nach dem mit 20 multiplizierten Renteneinkommen im Beitragsjahr. Nicht als Renteneinkommen gelten Leistungen der schweizerischen Invalidenversicherung (IV) sowie Ergänzungsleistungen (EL). Bei verheirateten Personen wird ungeachtet des Güterstandes das Vermögen und Renteneinkommen beider Ehegatten berücksichtigt, die Summe wird jedoch durch 2 geteilt."},"identifier":"p","id":"doc-1jcoh2bcu0"},{"properties":{"text":"Nichterwerbstätige können sich bei der zuständigen Ausgleichskasse auf der Webseite <a target=\"_blank\" href=\"https://www.nichterwerbstaetig.ch\" rel=\"external\" class=\"link--external\" aria-label=\"www.nichterwerbstaetig.ch Link in neuem Tab öffnen\">www.nichterwerbstaetig.ch</a> anmelden, die ausserdem umfangreiche Informationen zum Nichterwerbstätigenstatus liefert."},"identifier":"p","id":"doc-1k4ve2sbf1"},{"properties":{"text":"Mit dem nachfolgenden Berechnungsmodul können Beitragsberechnungen erstellt werden. Dabei handelt es sich um Richtwerte."},"identifier":"p","id":"doc-1jcoh2ufj0"},{"properties":{"accordionSettings":"closed"},"identifier":"accordion-container","id":"doc-1j8ku4p3h0","nestedContent":[{"properties":{"accordionItems":{"title":"Beitragsberechnung für Nichterwerbstätige (Onlinerechner)"}},"identifier":"accordion-item","id":"doc-1j8ku4p3h1","nestedContent":[{"properties":{"title":"","src":"https://rechner.soziale-sicherheit-chss.ch/nichterwerbstaetige","classAttributes":"ratio ratio--1/1","width":"100%","height":"100%","allowFullScreen":true,"loading":"lazy","sizingMode":"fixed","legend":""},"identifier":"iframe","id":"doc-1j8ku51920"},{"properties":{"text":""},"identifier":"p","id":"doc-1j8ku4p3h2"}]}]},{"properties":{"text":"Weitere Informationen finden Sie in den Dokumenten auf folgenden Internetseiten:"},"identifier":"p","id":"doc-1j30psjv80"},{"properties":{"text":"<a href=\"https://www.ahv-iv.ch/de/Merkbl%C3%A4tter/Beitr%C3%A4ge-AHV-IV-EO-ALV\" target=\"_self\" rel=\"external\" class=\"link--external\" aria-label=\"Merkblätter der Infostelle AHV/IV \">Merkblätter der Infostelle AHV/IV </a>"},"identifier":"p","id":"doc-1j30psjv81"},{"properties":{"text":"<a href=\"https://sozialversicherungen.admin.ch/de/f/5621\" target=\"_self\" rel=\"external\" class=\"link--external\" aria-label=\"Weisungen und Beitragstabellen des BSV zuhanden der Ausgleichskassen\">Weisungen und Beitragstabellen des BSV zuhanden der Ausgleichskassen</a>"},"identifier":"p","id":"doc-1j30psjv82"},{"properties":{"heading":"h2","label":"Beiträge von freiwillig versicherten Personen","class":"","anchorNav":"Beiträge-von-freiwillig-versicherten-Personen"},"identifier":"heading-h2","id":"Beiträge-von-freiwillig-versicherten-Personen"},{"properties":{"text":"Schweizerinnen und Schweizer sowie EU- und EFTA-Staatsangehörige, die die Schweiz verlassen und deswegen aus der obligatorischen AHV/IV/EO-Versicherung ausscheiden, können sich der freiwilligen AHV/IV-Versicherung anschliessen, wenn sie ihren Wohnsitz ausserhalb eines EU- oder EFTA-Staates haben. In der freiwilligen AHV/IV-Versicherung gelten für die Beiträge und Leistungen dieselben Regeln wie in der obligatorischen Versicherung, ausser dass die versicherte Person sämtliche Beiträge selber übernehmen muss, unabhängig davon, ob sie angestellt oder selbstständigerwerbend ist."},"identifier":"p","id":"doc-1jcoh43r80"},{"properties":{"text":"Weitere Informationen finden Sie in den Dokumenten auf folgenden Internetseiten:"},"identifier":"p","id":"doc-1jcoh4fvd0"},{"properties":{"text":"<a href=\"https://www.ahv-iv.ch/de/Merkbl%C3%A4tter/Beitr%C3%A4ge-AHV-IV-EO-ALV\" target=\"_self\" rel=\"external\" class=\"link--external\" aria-label=\"Merkblätter der Infostelle AHV/IV \">Merkblätter der Infostelle AHV/IV </a>"},"identifier":"p","id":"doc-1j30q8rde0"},{"properties":{"text":"<a href=\"https://sozialversicherungen.admin.ch/de/f/5621\" target=\"_self\" rel=\"external\" class=\"link--external\" aria-label=\"Weisungen und Beitragstabellen des BSV zuhanden der Ausgleichskassen \">Weisungen und Beitragstabellen des BSV zuhanden der Ausgleichskassen </a>"},"identifier":"p","id":"doc-1j30q8snl0"},{"properties":{"text":"<a target=\"_blank\" href=\"https://www.zas.admin.ch/de/bezahlen-der-beitraege-fuer-die-freiwillige-ahviv\" rel=\"external\" class=\"link--external\" aria-label=\"Schweizerische Ausgleichskasse - Freiwillige AHV/IV Link in neuem Tab öffnen\">Schweizerische Ausgleichskasse - Freiwillige AHV/IV</a>"},"identifier":"p","id":"doc-1j30q8snm0"},{"properties":{"heading":"h2","label":"Kontakte","class":"","anchorNav":"Kontakte"},"identifier":"heading-h2","id":"Kontakte"},{"properties":{"text":"<a href=\